        "timeLimitSec": { "type": "number" },
        "enabledModes": { "type": "array" },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "referenceRequirement": { "type": "string", "maxLength": 500 },
        "isActive": { "type": "boolean" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["questionId", "topicName", "type", "questionText", "correctAnswer", "difficulty", "points", "timeLimitSec", "enabledModes", "isActive", "createdAt", "updatedAt"]
    },
    "Session": {
      "title": "Session",
      "description": "Live quiz competition session public state (never stores unpublished answer keys).",
