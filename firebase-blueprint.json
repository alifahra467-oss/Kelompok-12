        "buzzerWinnerTeamId": { "type": "string", "maxLength": 128 },
        "buzzerWinnerTeamName": { "type": "string", "maxLength": 80 },
        "buzzerWinnerParticipantName": { "type": "string", "maxLength": 60 },
        "submissionsOpen": { "type": "boolean" },
        "timerRunning": { "type": "boolean" },
        "timerDurationSec": { "type": "number" },
        "timerRemainingSec": { "type": "number" },
        "timerEndTimeMs": { "type": "number" },
        "submissionDeadline": { "type": "string", "format": "date-time" },
        "answerRevealed": { "type": "boolean" },
        "revealedAnswer": { "type": "string", "maxLength": 2000 },
        "explanationRevealed": { "type": "boolean" },
        "revealedExplanation": { "type": "string", "maxLength": 5000 },
        "revealedReference": { "type": "string", "maxLength": 500 },
        "statsReleased": { "type": "boolean" },
        "questionStats": { "type": "object" },
        "scoringConfig": { "type": "object" },
        "boardConfig": { "type": "object" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "title", "gameMode", "status", "joinCode", "requireJoinApproval", "isJoinLocked", "submissionMode", "buzzerOpen", "buzzerAttempt", "submissionsOpen", "timerRunning", "answerRevealed", "explanationRevealed", "statsReleased", "createdByUid", "createdAt", "updatedAt"]
    },
    "PublicQuestion": {
      "title": "PublicQuestion",
