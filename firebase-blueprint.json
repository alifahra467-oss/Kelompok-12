{
  "entities": {
    "Course": {
      "title": "Course",
      "description": "Single university course configuration managed by the lecturer.",
      "type": "object",
      "properties": {
        "courseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 1500 },
        "lecturerName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "semester": { "type": "string", "maxLength": 60 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["courseId", "title", "lecturerName", "semester", "updatedAt"]
    },
    "ApprovedLecturer": {
      "title": "ApprovedLecturer",
      "description": "Approved lecturer accounts authorized to administer the course.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "name": { "type": "string", "maxLength": 120 },
        "addedBy": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "Topic": {
      "title": "Topic",
      "description": "Course topic and subtopics.",
      "type": "object",
      "properties": {
        "topicId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "subtopics": { "type": "array" },
        "orderIndex": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["topicId", "name", "subtopics", "orderIndex", "updatedAt"]
    },
    "QuestionPrivate": {
      "title": "QuestionPrivate",
      "description": "Private question bank entry containing answer keys and unpublished explanations.",
      "type": "object",
      "properties": {
        "questionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "topicId": { "type": "string", "maxLength": 128 },
        "topicName": { "type": "string", "maxLength": 120 },
        "subtopic": { "type": "string", "maxLength": 120 },
        "type": { "type": "string", "enum": ["MULTIPLE_CHOICE", "TRUE_FALSE", "SHORT_ANSWER", "ESSAY_CASE"] },
        "questionText": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "options": { "type": "array" },
        "correctAnswer": { "type": "string", "maxLength": 2000 },
        "explanation": { "type": "string", "maxLength": 5000 },
        "reference": { "type": "string", "maxLength": 500 },
        "difficulty": { "type": "string", "enum": ["MUDAH", "SEDANG", "SULIT"] },
